{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run vercel:build",
  "crons": [
    {
      "path": "/api/cron/search-index-migration",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/vehicle-ingestion",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/vehicle-departures",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/search-alerts",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/cron/inventory-downstream",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/cron/ingestion-maintenance",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/database-usage",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/notification-delivery",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/search-projector",
      "schedule": "5-55/10 * * * *"
    }
  ]
}
